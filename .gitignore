
# macOS Finder metadata (OneDrive-synced folders create these constantly).
.DS_Store

# Local secrets. The scheduled worker runs with the Supabase service-role
# key from Actions secrets; a .env made while debugging must never land in
# this public repository through a routine `git add -A`.
.env
.env.*
!.env.example

# Scratch paths of the worker workflow: the nested engine checkout, the
# optional Vs30 raster cache and the assembled Pages tree. The commit step
# already stages only events/, index.json and id-crosswalk.json.
bumelerze-engine/
vs30-cache/
_site/
